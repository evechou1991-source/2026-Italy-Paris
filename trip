<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Travel Vibe Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; background-color: #0f172a; color: white; }
        .glass { background: rgba(30, 41, 59, 0.7); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.1); }
    </style>
</head>
<body class="p-6 md:p-12 min-h-screen">

    <header class="max-w-5xl mx-auto mb-10 flex justify-between items-end">
        <div>
            <h1 class="text-4xl md:text-5xl font-bold tracking-tighter bg-gradient-to-r from-blue-400 to-purple-500 bg-clip-text text-transparent">
                Tokyo Drift 2026 🇯🇵
            </h1>
            <p class="text-slate-400 mt-2 font-light">Feb 25 - Mar 02 • Adventure Mode On</p>
        </div>
        <div class="hidden md:block px-4 py-2 rounded-full border border-blue-500/50 text-blue-400 text-sm font-medium animate-pulse">
            LIVE: Day 3
        </div>
    </header>

    <main class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <div class="md:col-span-2 space-y-6">
            <h2 class="text-xl font-semibold flex items-center gap-2 mb-4">
                <i data-lucide="calendar" class="w-5 h-5 text-blue-400"></i> Today's Vibe
            </h2>
            
            <div class="glass p-6 rounded-3xl hover:scale-[1.02] transition-transform cursor-pointer">
                <div class="flex justify-between items-start">
                    <div>
                        <span class="text-xs font-mono text-blue-400 uppercase tracking-widest">10:30 AM</span>
                        <h3 class="text-xl font-semibold mt-1">Shibuya Crossing</h3>
                        <p class="text-slate-400 text-sm mt-2 flex items-center gap-1">
                            <i data-lucide="map-pin" class="w-3 h-3"></i> Shibuya, Tokyo
                        </p>
                    </div>
                    <div class="bg-blue-500/20 p-3 rounded-2xl">
                        <i data-lucide="camera" class="text-blue-400"></i>
                    </div>
                </div>
            </div>

            <div class="glass p-6 rounded-3xl border-l-4 border-l-purple-500 relative overflow-hidden">
                <div class="absolute top-0 right-0 p-4 opacity-10">
                    <i data-lucide="utensils" class="w-20 h-20"></i>
                </div>
                <span class="text-xs font-mono text-purple-400 uppercase tracking-widest">01:00 PM • NOW</span>
                <h3 class="text-xl font-semibold mt-1">Ichiran Ramen Lunch</h3>
                <p class="text-slate-400 text-sm mt-2">Don't forget to customize the richness!</p>
            </div>
        </div>

        <div class="space-y-6">
            <div class="bg-gradient-to-br from-indigo-600 to-purple-700 p-8 rounded-[2rem] shadow-2xl shadow-indigo-500/20">
                <div class="flex justify-between mb-6">
                    <i data-lucide="wallet" class="opacity-80"></i>
                    <span class="text-[10px] bg-white/20 px-2 py-1 rounded-md uppercase">Budget Remaining</span>
                </div>
                <div class="text-4xl font-bold tracking-tight">¥84,200</div>
                <div class="mt-6 h-1.5 bg-black/20 rounded-full overflow-hidden">
                    <div class="w-3/4 h-full bg-white rounded-full"></div>
                </div>
            </div>

            <div class="glass p-6 rounded-[2rem] flex items-center justify-between">
                <div>
                    <p class="text-slate-400 text-xs uppercase tracking-tighter">Current Weather</p>
                    <p class="text-2xl font-bold mt-1 text-yellow-400">12°C Sunny</p>
                </div>
                <i data-lucide="sun" class="w-10 h-10 text-yellow-400"></i>
            </div>

            <button class="w-full py-4 bg-white text-black font-bold rounded-2xl hover:bg-blue-400 hover:text-white transition-all flex items-center justify-center gap-2 group">
                Add New Spot
                <i data-lucide="plus-circle" class="w-5 h-5 group-hover:rotate-90 transition-transform"></i>
            </button>
        </div>
    </main>

    <script>
        // 初始化 Lucide 圖示
        lucide.createIcons();
    </script>
</body>
</html>
